{
  "name": "vue3-monorepo-template",
  "version": "1.0.0",
  "description": "企业级 Vue3 monorepo 模板（pnpm workspace + admin PC + H5 mobile）",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "__comment_monorepo": "----- monorepo 级别脚本（-r = --recursive；--filter=<name> 定向单包/子集） -----",
    "admin:dev": "pnpm --filter @vue3-mono/admin dev",
    "admin:build": "pnpm --filter @vue3-mono/admin build",
    "admin:typecheck": "pnpm --filter @vue3-mono/admin typecheck",
    "admin:test": "pnpm --filter @vue3-mono/admin test",
    "h5:dev": "pnpm --filter @vue3-mono/h5 dev",
    "h5:build": "pnpm --filter @vue3-mono/h5 build",
    "h5:typecheck": "pnpm --filter @vue3-mono/h5 typecheck",
    "h5:test": "pnpm --filter @vue3-mono/h5 test",
    "docs:dev": "pnpm --filter @vue3-mono/docs dev",
    "docs:build": "pnpm --filter @vue3-mono/docs build",
    "docs:preview": "pnpm --filter @vue3-mono/docs preview",
    "typecheck": "pnpm -r --parallel run --if-present typecheck",
    "typecheck:packages": "pnpm -r --parallel --filter './packages/**' run --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint '{apps,docs,packages}/**/*.{scss,vue,css}'",
    "lint:style:fix": "stylelint '{apps,docs,packages}/**/*.{scss,vue,css}' --fix",
    "format": "prettier --write .",
    "check:refs": "node scripts/check-refs.js",
    "check:request-core": "node scripts/check-request-core.js",
    "verify:p3": "pnpm run check:refs && pnpm run check:request-core && pnpm run typecheck && pnpm run lint && pnpm run lint:style && prettier --check . && pnpm run test:run && pnpm run build",
    "docker:admin:up": "bash scripts/docker.sh up",
    "docker:admin:down": "bash scripts/docker.sh stop",
    "docker:admin:logs": "bash scripts/docker.sh logs",
    "type-check": "pnpm run typecheck",
    "test:run": "pnpm run test",
    "build": "pnpm run admin:build && pnpm run h5:build && pnpm run docs:build",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps,docs,packages}/**/*.{ts,vue,js,mjs}": "eslint --fix",
    "{apps,docs,packages}/**/*.{scss,vue,css}": "stylelint --fix",
    "{apps,docs,packages}/**/*.{ts,vue,js,json,scss,css,md,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "postcss-html": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-html": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-prettier": "catalog:",
    "stylelint-scss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:"
  }
}
