# H5：Vite 仅加载本应用目录下的 .env*；可复制为 .env.development / .env.production 等后按需修改
# 客户端可见变量必须以 VITE_ 开头

VITE_APP_TITLE=vue3-monorepo
VITE_API_BASE_URL=http://localhost:3000
VITE_API_PREFIX=/api
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_API_SUCCESS_CODE=200
VITE_USE_MOCK=true
VITE_ANALYZE=false
VITE_SOURCEMAP=false

# H5 可选
VITE_H5_VIEWPORT_WIDTH=375
# true 时在「我的」页显示「测试错误上报」入口（跳转 /dev/error-collect）
# VITE_H5_SHOW_ERROR_REPORT_TEST=true

# ---------- Web Vitals（express-monitor-monorepo：默认端口 4001）----------
# 上报地址（无鉴权时用这个即可）
VITE_WEB_VITALS_REPORT_URL=http://localhost:4001/collect/web-vitals
# 若监控 API 在 packages/server/.env 配置了 INGEST_SECRET，请改成（token 与 INGEST_SECRET 完全相同）：
# VITE_WEB_VITALS_REPORT_URL=http://localhost:4001/collect/web-vitals?token=这里填INGEST_SECRET的值
# true=每条指标打印 console；false=即使在 DEV 也不刷日志（但仍上报）；未配置则 DEV 默认打印每条
VITE_WEB_VITALS_DEBUG=false

# ---------- 前端错误（与 Web Vitals 同一 express-monitor 服务）----------
VITE_ERROR_REPORT_URL=http://localhost:4001/collect/client-errors
# VITE_ERROR_REPORT_URL=http://localhost:4001/collect/client-errors?token=与INGEST_SECRET相同
VITE_ERROR_REPORT_DEBUG=false

# 可选：上报载荷中的版本号（与 Web Vitals、client-error 共用）
# VITE_APP_VERSION=
