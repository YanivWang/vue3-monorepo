{
  "name": "@vue3-monorepo/h5",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "H5 移动端应用（Vant 4 + 多宿主 Bridge）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:dev": "vue-tsc --noEmit -p tsconfig.json && vite build --mode development",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,vue}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "lint:style": "stylelint \"src/**/*.{scss,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vue3-monorepo/shared": "workspace:*",
    "@vueuse/core": "catalog:",
    "axios": "catalog:",
    "dayjs": "catalog:",
    "lodash-es": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "vant": "catalog:",
    "vconsole": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "postcss-mobile-forever": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-compression2": "catalog:",
    "vite-plugin-mock": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
