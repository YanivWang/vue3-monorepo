# 本地开发：启用 vite-plugin-mock（apps/h5/mock），接口前缀与代理一致
VITE_USE_MOCK=true
VITE_API_PREFIX=/api

# Web Vitals → express-monitor-monorepo（需先启动监控 API：pnpm dev，端口 4001）
VITE_WEB_VITALS_REPORT_URL=http://localhost:4001/collect/web-vitals
VITE_WEB_VITALS_DEBUG=false

VITE_ERROR_REPORT_URL=http://localhost:4001/collect/client-errors
VITE_ERROR_REPORT_DEBUG=false

# VITE_APP_VERSION — 可选，写入 Web Vitals / 前端错误载荷 appVersion

# 「我的」页显示「测试错误上报」入口；线上请在对应 .env 中按需开启或删除此行
VITE_H5_SHOW_ERROR_REPORT_TEST=true
