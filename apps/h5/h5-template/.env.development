# 本地开发：启用 vite-plugin-mock（apps/h5/mock），接口前缀与代理一致
VITE_USE_MOCK=true
VITE_API_PREFIX=/api

# Web Vitals → express-monitor-monorepo（需先启动监控 API：pnpm dev，端口 4000）
VITE_WEB_VITALS_REPORT_URL=http://localhost:4000/collect/web-vitals
VITE_WEB_VITALS_DEBUG=false

VITE_ERROR_REPORT_URL=http://localhost:4000/collect/client-errors
VITE_ERROR_REPORT_DEBUG=false

# Sentry（可选，留空则不初始化）
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENV=development
# VITE_APP_VERSION=0.0.0
