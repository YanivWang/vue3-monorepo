# Staging 环境配置
# 对应 Dockerfile --build-arg BUILD_MODE=staging
# Vite 会加载 .env + .env.staging 合并后注入

# Staging 后端接口地址（替换为实际 staging 服务器地址）
VITE_API_BASE_URL=https://api-staging.your-domain.com

# Staging 关闭 mock，使用真实 staging 接口
VITE_USE_MOCK=false

# Staging 开启 Source Map，便于排查线上问题
VITE_SOURCEMAP=true
