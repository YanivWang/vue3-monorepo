# 开发环境联调真实后端时填写；VITE_USE_MOCK=true 时由代码改为同源 /api，经 devServer 走 mock，不依赖本机 3000
VITE_API_BASE_URL=http://localhost:3000

# 开发环境是否开启 mock（true 时登录等走内建假数据，便于无后端联调）
VITE_USE_MOCK=true

# ---------- Web Vitals / 前端错误（默认与 H5 相同联调地址；不需要上报可留空或删除）----------
VITE_WEB_VITALS_REPORT_URL=http://localhost:4001/collect/web-vitals
VITE_WEB_VITALS_DEBUG=false
VITE_ERROR_REPORT_URL=http://localhost:4001/collect/client-errors
VITE_ERROR_REPORT_DEBUG=false
