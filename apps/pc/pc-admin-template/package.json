{
  "name": "@vue3-monorepo/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PC 管理后台（Vue3 + Element Plus），企业级 admin 模板",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "build:dev": "pnpm run typecheck && vite build --mode development",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.vitest.json",
    "lint": "eslint \"src/**/*.{ts,vue}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "lint:style": "stylelint \"src/**/*.{scss,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:api": "node --import tsx/esm scripts/gen-api.ts",
    "gen:api:remote": "node --import tsx/esm scripts/gen-api.ts --remote"
  },
  "dependencies": {
    "@vue3-monorepo/shared": "workspace:*",
    "@vue3-monorepo/web-monitor": "workspace:*",
    "@element-plus/icons-vue": "catalog:",
    "@vueuse/core": "catalog:",
    "axios": "catalog:",
    "dayjs": "catalog:",
    "echarts": "catalog:",
    "element-plus": "catalog:",
    "js-cookie": "catalog:",
    "lodash-es": "catalog:",
    "nprogress": "catalog:",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "vue": "catalog:",
    "vue-echarts": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@types/js-cookie": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/nprogress": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "openapi-typescript": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "sass": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-compression2": "catalog:",
    "vite-plugin-fake-server": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
