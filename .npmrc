# 与 package.json engines 一致：Node / pnpm 不满足版本时安装失败
engine-strict=true

# pnpm monorepo 配置
# 文档：https://pnpm.io/npmrc

# 严格依赖声明：不允许 hoist 让未声明的依赖变得"意外可用"
# 配合 catalog 使用，避免某个包偷偷依赖了没声明的包
strict-peer-dependencies=false

# 依赖被 link 而不是 copy，保留 workspace 的软链接特性
link-workspace-packages=true

# 允许 workspace:* 协议自动解析到当前仓库包的实际版本
prefer-workspace-packages=true

# 关闭 .pnpmfile.cjs 自动读取（项目无此文件）
ignore-pnpmfile=false

# 避免 vue-demi / 某些 peer 的 hoist 带来的 "多实例" 问题
# 这些包必须放到各包自己的 node_modules 根下
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*stylelint*

# shamefully-hoist 关闭：不把所有依赖 hoist 到根 node_modules，保持隔离
shamefully-hoist=false

# 自动安装 peer dependencies（pnpm 8+ 默认 true，显式声明）
auto-install-peers=true

# 同一依赖存在多版本时给出警告，帮助发现未使用 catalog 的漏网之鱼
resolution-mode=highest

# monorepo 中允许 workspace 包之间互相依赖使用 workspace: 协议
save-workspace-protocol=rolling
