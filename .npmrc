# pnpm 配置。每条都写清楚「这个选项实际做什么」，不要写成愿望。
# 文档：https://pnpm.io/npmrc

# 与 package.json 的 engines 对齐：Node / pnpm 版本不满足时**安装直接失败**，
# 而不是装完了再在别处以奇怪的方式炸。版本真源见 .nvmrc / engines / packageManager，
# 一致性由 scripts/check-toolchain.mjs 守。
engine-strict=true

# peer 依赖不匹配时只警告、不让 install 失败。
# 本仓库确实有一批 peer 范围滞后的库（Vue 生态常态），设成 true 会让安装无法完成。
# 注意它管的是「peer 不匹配要不要报错」，跟 hoist、跟依赖是否声明都没有关系。
strict-peer-dependencies=false

# workspace 内部依赖用软链接指向本地包目录，而不是从 registry 下载同名包。
# pnpm 10 起该项默认已改为 false，所以这里必须显式打开。
link-workspace-packages=true

# 解析版本范围时优先用本地 workspace 里的包（即便 registry 上有更高版本）。
prefer-workspace-packages=true

# 读取 .pnpmfile.cjs（false = 不忽略 = 默认行为）。当前仓库没有该文件，
# 显式写出来是为了「将来有人加了 pnpmfile，行为不会因为这行而意外改变」。
ignore-pnpmfile=false

# 把匹配的包额外提升到**根** node_modules，让编辑器与各种工具在仓库根也能解析到。
# 只放工具链与类型声明：它们要被编辑器 / eslint / stylelint 直接找到，
# 而不像运行时依赖那样必须由各包自己显式声明。
# （pnpm 默认值是 *eslint* 与 *prettier*，这里是在其基础上扩了 types / stylelint。）
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*stylelint*

# 不把全部依赖平铺到根 node_modules：未声明的依赖就应该 import 不到，
# 这是 pnpm 相对 npm/yarn 最有价值的一条约束，别为了「省事」打开。
shamefully-hoist=false

# 自动安装 peer dependencies（pnpm 8+ 默认即 true，显式写出来免得被误以为关着）。
auto-install-peers=true

# 版本范围解析取满足范围的最高版本（pnpm 的默认值，显式声明以免被上游默认值变更带跑）。
# 注意：它不会「对多版本告警」——发现同一依赖多版本要用 pnpm dedupe / pnpm why，
# 而防漂移靠的是 pnpm-workspace.yaml 的 catalog。
resolution-mode=highest

# pnpm add 一个 workspace 内的包时，写进 package.json 的是 workspace:^ 而不是死版本号。
save-workspace-protocol=rolling
