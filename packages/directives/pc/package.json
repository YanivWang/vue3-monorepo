{
  "name": "@vue3-mono/directives-pc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PC 端自定义指令（v-permission / v-role / v-copy 等）",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
