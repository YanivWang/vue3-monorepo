{
  "name": "@vue3-mono/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "与 UI 无关的通用工具（日期 / 存储 / URL / 校验 / 脱敏 / 宿主检测 / echarts / web-vitals）",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@vue3-mono/shared": "workspace:*",
    "dayjs": "catalog:",
    "echarts": "catalog:",
    "js-cookie": "catalog:",
    "lodash-es": "catalog:",
    "web-vitals": "catalog:"
  },
  "devDependencies": {
    "@types/js-cookie": "catalog:",
    "@types/lodash-es": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vue-tsc": "catalog:"
  }
}
