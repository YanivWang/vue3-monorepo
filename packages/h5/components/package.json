{
  "name": "@vue3-mono/components-h5",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "H5 端共享业务组件（Vant 4 生态）",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts,.vue"
  },
  "dependencies": {
    "@vue3-mono/shared": "workspace:*",
    "@vue3-mono/hooks": "workspace:*",
    "@vue3-mono/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:",
    "vant": "catalog:",
    "@vueuse/core": "catalog:"
  },
  "devDependencies": {
    "@vant/auto-import-resolver": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vueuse/core": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vant": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
