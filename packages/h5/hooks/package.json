{
  "name": "@vue3-mono/hooks-h5",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "依赖 Vant / bridge / vue-router 的 H5 专用 hooks",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@vue3-mono/hooks": "workspace:*",
    "@vue3-mono/bridge": "workspace:*",
    "@vue3-mono/shared": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vant": "catalog:",
    "vconsole": "catalog:"
  },
  "peerDependenciesMeta": {
    "vconsole": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vant": "catalog:",
    "vconsole": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  }
}
