{
  "name": "@vue3-mono/hooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "两端共享的通用 hooks（UI 库无关）",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@vue3-mono/shared": "workspace:*",
    "@vue3-mono/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:",
    "vue-router": "catalog:",
    "@vueuse/core": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "@vueuse/core": "catalog:",
    "vue-tsc": "catalog:"
  }
}
