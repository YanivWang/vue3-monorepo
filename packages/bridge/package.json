{
  "name": "@vue3-mono/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "多宿主抽象层（浏览器 / 微信小程序 WebView / 支付宝小程序 WebView / 原生 APP WebView）",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@vue3-mono/shared": "workspace:*",
    "@vue3-mono/utils": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
