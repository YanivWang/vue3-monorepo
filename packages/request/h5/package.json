{
  "name": "@vue3-mono/request-h5",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "H5 端 request preset：核心 request + Vant 默认 UI 反馈",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@vue3-mono/request": "workspace:*",
    "@vue3-mono/utils": "workspace:*"
  },
  "peerDependencies": {
    "vant": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vant": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
