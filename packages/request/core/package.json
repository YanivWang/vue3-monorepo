{
  "name": "@vue3-mono/request",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UI 无关的 HTTP 核心（axios 封装 / 拦截器 / token 刷新单例 / 重试 / 错误归一化）",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "axios": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vue-tsc": "catalog:"
  }
}
