{
  "name": "@vue3-mono/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "基础类型 / 枚举 / 常量 / design tokens（两端共享，纯源码包）",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    },
    "./enums": {
      "types": "./src/enums/index.ts",
      "import": "./src/enums/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "import": "./src/constants/index.ts"
    },
    "./styles/*": "./src/styles/*",
    "./styles/tokens/*": "./src/styles/tokens/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  }
}
