# 应用标题
VITE_APP_TITLE=vue3-app-template

# API 请求前缀
VITE_API_PREFIX=/api

# Token 存储 key
VITE_TOKEN_KEY=access_token

# Refresh Token 存储 key（Cookie）
VITE_REFRESH_TOKEN_KEY=refresh_token

# 业务成功码（与后端约定）
VITE_API_SUCCESS_CODE=200

# Token 刷新接口路径（相对 baseURL，默认 /auth/refresh）
VITE_REFRESH_PATH=/auth/refresh

# 是否开启打包分析（true 时 build 后自动打开 stats.html）
VITE_ANALYZE=false

# Web Vitals 上报端点（留空则不上报，生产环境填写真实接口地址）
# 示例：VITE_VITALS_ENDPOINT=https://analytics.example.com/vitals
VITE_VITALS_ENDPOINT=

# Sentry 错误监控（留空则不初始化）
# 从 Sentry 控制台获取 DSN：https://sentry.io/settings/[org]/projects/[project]/keys/
VITE_SENTRY_DSN=
# Sentry 环境标识（production | staging | development）
VITE_SENTRY_ENV=development
# 应用版本号，用于 Sentry Release（通常由 CI 注入）
VITE_APP_VERSION=1.0.0
