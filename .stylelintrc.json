{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-standard-scss",
    "stylelint-config-recess-order",
    "stylelint-config-html/vue",
    "stylelint-prettier/recommended"
  ],
  "plugins": ["stylelint-scss", "stylelint-order"],
  "rules": {
    "no-descending-specificity": null,
    "scss/at-import-partial-extension": null,
    "scss/no-global-function-names": null,
    "import-notation": null,
    "alpha-value-notation": null,
    "color-function-notation": null,
    "color-function-alias-notation": null,
    "color-hex-length": null,
    "property-no-vendor-prefix": null,
    "value-keyword-case": ["lower", { "camelCaseSvgKeywords": true }],
    "scss/load-partial-extension": ["never"],
    "rule-empty-line-before": [
      "always",
      {
        "except": ["first-nested"],
        "ignore": ["after-comment", "inside-block"]
      }
    ],
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["deep", "slotted", "global"] }],
    "selector-class-pattern": [
      "^([a-z][a-z0-9]*)(-[a-z0-9]+)*(__[a-z][a-z0-9]*(-[a-z0-9]+)*)?(--[a-z][a-z0-9]*(-[a-z0-9]+)*)?$",
      {
        "resolveNestedSelectors": true,
        "message": "Expected class selector to be kebab-case / BEM (selector-class-pattern)"
      }
    ]
  },
  "ignoreFiles": [
    "dist/**",
    "**/dist/**",
    "coverage/**",
    "**/coverage/**",
    "node_modules/**",
    "**/node_modules/**",
    "**/*.js",
    "**/*.ts",
    "**/.vitepress/dist/**"
  ],
  "overrides": [
    {
      "files": [
        "apps/**/src/**/*.{vue,scss}",
        "packages/shared/src/components-pc/**/*.{vue,scss}",
        "packages/shared/src/components-h5/**/*.{vue,scss}"
      ],
      "rules": {
        "color-no-hex": [
          true,
          {
            "message": "Use var(--color-*) design tokens instead of hex colors in app UI code."
          }
        ]
      }
    },
    {
      "files": ["packages/shared/src/styles/tokens/**", "packages/shared/src/styles/patterns/**"],
      "rules": {
        "color-no-hex": null,
        "value-keyword-case": null,
        "prettier/prettier": null
      }
    }
  ]
}
