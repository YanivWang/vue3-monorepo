// Solution 根配置：不直接编译源码，只把子工程挂在一起
// 参考 https://www.typescriptlang.org/docs/handbook/project-references.html
//
// 设计：
// - tsconfig.base.json       -> 共享基础（strict + paths 22 个别名）
// - tsconfig.web.json        -> apps/{admin,h5} 使用（DOM + vite/client）
// - tsconfig.pkg.json        -> packages/* 类型校验（noEmit + 解析 cross-package 源码）
// - tsconfig.lib.json        -> packages/* 需要 composite 产物时使用（保留能力）
// - tsconfig.node.json       -> 根脚本 / 各 app 的 vite|vitest|scripts 使用（Node + CommonJS/ESM）
//
// references：3 apps + 14 packages + 根 scripts 的 node 环境
{
  "files": [],
  "references": [
    { "path": "./tsconfig.node.json" },

    { "path": "./apps/admin" },
    { "path": "./apps/admin/tsconfig.node.json" },
    { "path": "./apps/docs" },

    { "path": "./packages/shared" },
    { "path": "./packages/utils" },
    { "path": "./packages/bridge" },
    { "path": "./packages/request" },
    { "path": "./packages/locale" },
    { "path": "./packages/hooks" },

    { "path": "./packages/pc/components" },
    { "path": "./packages/pc/hooks" },
    { "path": "./packages/pc/directives" },
    { "path": "./packages/pc/request" },

    { "path": "./packages/h5/components" },
    { "path": "./packages/h5/hooks" },
    { "path": "./packages/h5/directives" },
    { "path": "./packages/h5/request" }
  ]
}
