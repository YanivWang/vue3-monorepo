# Monorepo 环境变量说明：请按应用复制到对应目录（如 apps/pc/pc-admin-template/.env.development、apps/h5/h5-template/.env.development）
# Vite 仅加载各 app 工作目录下的 .env*

# ── Admin / H5 通用（Vite 客户端可见变量必须以 VITE_ 开头）────────────────────
VITE_APP_TITLE=vue3-monorepo-template
VITE_API_BASE_URL=http://localhost:3000
VITE_API_PREFIX=/api
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_API_SUCCESS_CODE=200
VITE_USE_MOCK=true
VITE_ANALYZE=false
VITE_SOURCEMAP=false

# ── H5 应用可选（apps/h5/h5-template） ────────────────────────────────────────────────────────────
VITE_H5_VIEWPORT_WIDTH=375
