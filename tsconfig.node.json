{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "commitlint.config.ts",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.mjs"
  ]
}
